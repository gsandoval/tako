{
  "module": "shortlink",
  "services": [
    {
      "name": "shortlink",
      "package": "shortlink",
      "handlers": [
        "shortlink.Create",
        "shortlink.Resolve",
        "shortlink.List"
      ],
      "profile": "default"
    },
    {
      "name": "shortlink-countclick",
      "package": "shortlink",
      "handlers": [
        "shortlink.CountClick"
      ],
      "profile": "default"
    }
  ],
  "resources": [
    {
      "kind": "entity",
      "name": "links",
      "var": "shortlink.links",
      "package": "shortlink",
      "type": "Link",
      "indexes": [
        "Owner",
        "Created"
      ],
      "composites": [
        [
          "owner",
          "-created"
        ]
      ],
      "pos": "app.go:11:2"
    },
    {
      "kind": "queue",
      "name": "clicks",
      "var": "shortlink.clicks",
      "package": "shortlink",
      "type": "Click",
      "pos": "app.go:12:2"
    },
    {
      "kind": "entity",
      "name": "clicks-seen",
      "var": "shortlink.seen",
      "package": "shortlink",
      "type": "Click",
      "pos": "app.go:13:2"
    }
  ],
  "handlers": [
    {
      "kind": "api",
      "var": "shortlink.Create",
      "package": "shortlink",
      "service": "shortlink",
      "route": "POST /api/links",
      "req_type": "CreateReq",
      "req_ref": "shortlink.CreateReq",
      "res_ref": "shortlink.Link",
      "has_body": true,
      "pos": "app.go:33:2"
    },
    {
      "kind": "api",
      "var": "shortlink.Resolve",
      "package": "shortlink",
      "service": "shortlink",
      "route": "GET /api/links/{slug}",
      "req_type": "ResolveReq",
      "req_ref": "shortlink.ResolveReq",
      "res_ref": "shortlink.Link",
      "bindings": [
        {
          "field": "Slug",
          "kind": "path",
          "name": "slug",
          "type": "string"
        }
      ],
      "pos": "app.go:34:2"
    },
    {
      "kind": "api",
      "var": "shortlink.List",
      "package": "shortlink",
      "service": "shortlink",
      "route": "GET /api/links",
      "req_type": "ListReq",
      "req_ref": "shortlink.ListReq",
      "res_ref": "[]shortlink.Link",
      "bindings": [
        {
          "field": "Owner",
          "kind": "query",
          "name": "owner",
          "type": "string"
        }
      ],
      "pos": "app.go:35:2"
    },
    {
      "kind": "worker",
      "var": "shortlink.CountClick",
      "package": "shortlink",
      "service": "shortlink-countclick",
      "binding": "clicks",
      "pos": "app.go:37:2"
    }
  ],
  "edges": [
    {
      "from": "shortlink.Create",
      "to": "links",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "write"
    },
    {
      "from": "shortlink.Resolve",
      "to": "clicks",
      "to_kind": "queue",
      "kind": "resource",
      "verb": "publish"
    },
    {
      "from": "shortlink.Resolve",
      "to": "links",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "read"
    },
    {
      "from": "shortlink.List",
      "to": "links",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "read"
    },
    {
      "from": "shortlink.CountClick",
      "to": "clicks-seen",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "write"
    },
    {
      "from": "shortlink.CountClick",
      "to": "links",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "write"
    }
  ]
}
