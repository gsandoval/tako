      "bindings": [
        {
          "field": "Slug",
          "kind": "path",
          "name": "slug",
          "type": "string"
        }
      ],
      "pos": "app.go:23:2"
    },
    {
      "kind": "api",
      "var": "shortlink.List",
      "package": "shortlink",
      "service": "shortlink",
      "route": "GET /api/links",
      "req_type": "ListReq",
      "bindings": [
        {
          "field": "Owner",
          "kind": "query",
          "name": "owner",
          "type": "string"
        }
      ],
      "pos": "app.go:24:2"
    }
