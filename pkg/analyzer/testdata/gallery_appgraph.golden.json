{
  "module": "gallery",
  "services": [
    {
      "name": "gallery",
      "package": "gallery",
      "handlers": [
        "gallery.Upload",
        "gallery.StartUpload",
        "gallery.Download",
        "gallery.Image",
        "gallery.Thumb",
        "gallery.List",
        "gallery.Objects"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-onuploaded",
      "package": "gallery",
      "handlers": [
        "gallery.OnUploaded"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-makethumb",
      "package": "gallery",
      "handlers": [
        "gallery.MakeThumb"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-notifyowner",
      "package": "gallery",
      "handlers": [
        "gallery.NotifyOwner"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-warmfeed",
      "package": "gallery",
      "handlers": [
        "gallery.WarmFeed"
      ],
      "profile": "default"
    }
  ],
  "resources": [
    {
      "kind": "bucket",
      "name": "photos",
      "var": "gallery.photos",
      "package": "gallery",
      "pos": "app.go:13:2"
    },
    {
      "kind": "entity",
      "name": "photos",
      "var": "gallery.photoStore",
      "package": "gallery",
      "type": "Photo",
      "indexes": [
        "Ready"
      ],
      "pos": "app.go:14:2"
    },
    {
      "kind": "queue",
      "name": "thumbnails",
      "var": "gallery.thumbs",
      "package": "gallery",
      "type": "ThumbJob",
      "pos": "app.go:15:2"
    },
    {
      "kind": "topic",
      "name": "photo-ready",
      "var": "gallery.ready",
      "package": "gallery",
      "type": "PhotoReady",
      "pos": "app.go:16:2"
    },
    {
      "kind": "cache",
      "name": "feed",
      "var": "gallery.feed",
      "package": "gallery",
      "pos": "app.go:22:2"
    },
    {
      "kind": "secret",
      "name": "notifier-key",
      "var": "gallery.notifier",
      "package": "gallery",
      "pos": "app.go:23:2"
    },
    {
      "kind": "counter",
      "name": "uploads",
      "var": "gallery.ups",
      "package": "gallery",
      "pos": "app.go:24:2"
    },
    {
      "kind": "histogram",
      "name": "thumb_ms",
      "var": "gallery.thumbMs",
      "package": "gallery",
      "pos": "app.go:25:2"
    }
  ],
  "handlers": [
    {
      "kind": "api",
      "var": "gallery.Upload",
      "package": "gallery",
      "service": "gallery",
      "route": "POST /api/photos",
      "req_type": "UploadReq",
      "bindings": [
        {
          "field": "Caption",
          "kind": "form",
          "name": "caption",
          "type": "string"
        },
        {
          "field": "Img",
          "kind": "blob",
          "name": "img",
          "type": "blob"
        }
      ],
      "pos": "app.go:46:2"
    },
    {
      "kind": "api",
      "var": "gallery.StartUpload",
      "package": "gallery",
      "service": "gallery",
      "route": "POST /api/uploads",
      "req_type": "StartUploadReq",
      "has_body": true,
      "pos": "app.go:47:2"
    },
    {
      "kind": "api",
      "var": "gallery.Download",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos/{id}/download",
      "req_type": "DownloadReq",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "pos": "app.go:48:2"
    },
    {
      "kind": "api",
      "var": "gallery.Image",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos/{id}/image",
      "req_type": "ImageReq",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "res_blob": true,
      "pos": "app.go:49:2"
    },
    {
      "kind": "api",
      "var": "gallery.Thumb",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos/{id}/thumb",
      "req_type": "ThumbReq",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "res_blob": true,
      "pos": "app.go:50:2"
    },
    {
      "kind": "api",
      "var": "gallery.List",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos",
      "pos": "app.go:51:2"
    },
    {
      "kind": "api",
      "var": "gallery.Objects",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/objects",
      "pos": "app.go:52:2"
    },
    {
      "kind": "subscribe",
      "var": "gallery.OnUploaded",
      "package": "gallery",
      "service": "gallery-onuploaded",
      "binding": "photos.Uploaded",
      "binding_kind": "bucket",
      "pos": "app.go:56:2"
    },
    {
      "kind": "worker",
      "var": "gallery.MakeThumb",
      "package": "gallery",
      "service": "gallery-makethumb",
      "binding": "thumbnails",
      "pos": "app.go:57:2"
    },
    {
      "kind": "subscribe",
      "var": "gallery.NotifyOwner",
      "package": "gallery",
      "service": "gallery-notifyowner",
      "binding": "photo-ready",
      "binding_kind": "topic",
      "pos": "app.go:58:2"
    },
    {
      "kind": "subscribe",
      "var": "gallery.WarmFeed",
      "package": "gallery",
      "service": "gallery-warmfeed",
      "binding": "photo-ready",
      "binding_kind": "topic",
      "pos": "app.go:59:2"
    }
  ],
  "edges": []
}
