      "verb": "publish"
    },
    {
      "from": "gallery.MakeThumb",
      "to": "photos",
      "to_kind": "bucket",
      "kind": "resource",
      "verb": "read"
    },
    {
      "from": "gallery.MakeThumb",
      "to": "photos",
      "to_kind": "bucket",
      "kind": "resource",
      "verb": "write"
    },
    {
      "from": "gallery.MakeThumb",
      "to": "photos",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "read"
    },
    {
      "from": "gallery.MakeThumb",
      "to": "photos",
      "to_kind": "entity",
