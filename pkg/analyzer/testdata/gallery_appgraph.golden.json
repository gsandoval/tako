{
  "module": "gallery",
  "services": [
    {
      "name": "gallery",
      "package": "gallery",
      "handlers": [
        "gallery.Upload",
        "gallery.Image",
        "gallery.List",
        "gallery.Objects"
      ],
      "profile": "default"
    }
  ],
  "resources": [
    {
      "kind": "bucket",
      "name": "photos",
      "var": "gallery.photos",
      "package": "gallery",
      "pos": "app.go:6:2"
    },
    {
      "kind": "entity",
      "name": "photos",
      "var": "gallery.photoStore",
      "package": "gallery",
      "type": "Photo",
      "pos": "app.go:7:2"
    }
  ],
  "handlers": [
    {
      "kind": "api",
      "var": "gallery.Upload",
      "package": "gallery",
      "service": "gallery",
      "route": "POST /api/photos",
      "req_type": "UploadReq",
      "bindings": [
        {
          "field": "Caption",
          "kind": "form",
          "name": "caption",
          "type": "string"
        },
        {
          "field": "Img",
          "kind": "blob",
          "name": "img",
          "type": "blob"
        }
      ],
      "pos": "app.go:16:2"
    },
    {
      "kind": "api",
      "var": "gallery.Image",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos/{id}/image",
      "req_type": "ImageReq",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "res_blob": true,
      "pos": "app.go:17:2"
    },
    {
      "kind": "api",
      "var": "gallery.List",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos",
      "pos": "app.go:18:2"
    },
    {
      "kind": "api",
      "var": "gallery.Objects",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/objects",
      "pos": "app.go:19:2"
    }
  ],
  "edges": []
}
