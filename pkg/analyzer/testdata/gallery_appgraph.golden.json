      "res_ref": "tako.Blob",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "res_blob": true,
      "pos": "app.go:65:2"
    },
    {
      "kind": "api",
      "var": "gallery.Thumb",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos/{id}/thumb",
      "req_type": "ThumbReq",
      "req_ref": "gallery.ThumbReq",
      "res_ref": "tako.Blob",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "res_blob": true,
      "pos": "app.go:66:2"
    },
    {
      "kind": "api",
      "var": "gallery.List",
