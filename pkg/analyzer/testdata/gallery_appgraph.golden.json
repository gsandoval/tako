      "route": "GET /api/reindex/runs",
      "req_ref": "struct{}",
      "res_ref": "[]gallery.ReindexRun",
      "pos": "app.go:70:2"
    },
    {
      "kind": "subscribe",
      "var": "gallery.OnUploaded",
      "package": "gallery",
      "service": "gallery-onuploaded",
      "binding": "photos.Uploaded",
      "binding_kind": "bucket",
      "pos": "app.go:74:2"
    },
    {
      "kind": "worker",
      "var": "gallery.MakeThumb",
      "package": "gallery",
      "service": "gallery-makethumb",
      "profile": "batch",
      "footprint": {
        "memory": "4Gi",
        "concurrency": 4,
        "max_instances": 5
      },
      "binding": "thumbnails",
      "pos": "app.go:78:2"
    },
    {
      "kind": "subscribe",
      "var": "gallery.NotifyOwner",
      "package": "gallery",
      "service": "gallery-notifyowner",
      "binding": "photo-ready",
      "binding_kind": "topic",
      "pos": "app.go:83:2"
    },
    {
      "kind": "subscribe",
      "var": "gallery.WarmFeed",
      "package": "gallery",
      "service": "gallery-warmfeed",
      "binding": "photo-ready",
      "binding_kind": "topic",
      "pos": "app.go:84:2"
    },
    {
      "kind": "cron",
      "var": "gallery.Cleanup",
      "package": "gallery",
      "service": "gallery",
      "schedule": "every 24h",
      "singleflight": true,
      "pos": "app.go:85:2"
    }
  ],
