{
  "module": "gallery",
  "services": [
    {
      "name": "gallery",
      "package": "gallery",
      "handlers": [
        "gallery.Upload",
        "gallery.Image",
        "gallery.Thumb",
        "gallery.List",
        "gallery.Objects"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-makethumb",
      "package": "gallery",
      "handlers": [
        "gallery.MakeThumb"
      ],
      "profile": "default"
    }
  ],
  "resources": [
    {
      "kind": "bucket",
      "name": "photos",
      "var": "gallery.photos",
      "package": "gallery",
      "pos": "app.go:12:2"
    },
    {
      "kind": "entity",
      "name": "photos",
      "var": "gallery.photoStore",
      "package": "gallery",
      "type": "Photo",
      "pos": "app.go:13:2"
    },
    {
      "kind": "queue",
      "name": "thumbnails",
      "var": "gallery.thumbs",
      "package": "gallery",
      "type": "ThumbJob",
      "pos": "app.go:14:2"
    }
  ],
  "handlers": [
    {
      "kind": "api",
      "var": "gallery.Upload",
      "package": "gallery",
      "service": "gallery",
      "route": "POST /api/photos",
      "req_type": "UploadReq",
      "bindings": [
        {
          "field": "Caption",
          "kind": "form",
          "name": "caption",
          "type": "string"
        },
        {
          "field": "Img",
          "kind": "blob",
          "name": "img",
          "type": "blob"
        }
      ],
      "pos": "app.go:28:2"
    },
    {
      "kind": "api",
      "var": "gallery.Image",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos/{id}/image",
      "req_type": "ImageReq",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "res_blob": true,
      "pos": "app.go:29:2"
    },
    {
      "kind": "api",
      "var": "gallery.Thumb",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos/{id}/thumb",
      "req_type": "ThumbReq",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "res_blob": true,
      "pos": "app.go:30:2"
    },
    {
      "kind": "api",
      "var": "gallery.List",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/photos",
      "pos": "app.go:31:2"
    },
    {
      "kind": "api",
      "var": "gallery.Objects",
      "package": "gallery",
      "service": "gallery",
      "route": "GET /api/objects",
      "pos": "app.go:32:2"
    },
    {
      "kind": "worker",
      "var": "gallery.MakeThumb",
      "package": "gallery",
      "service": "gallery-makethumb",
      "binding": "thumbnails",
      "pos": "app.go:35:2"
    }
  ],
  "edges": []
}
