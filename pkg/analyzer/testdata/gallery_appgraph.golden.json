{
  "module": "gallery",
  "services": [
    {
      "name": "gallery",
      "package": "gallery",
      "handlers": [
        "gallery.Upload",
        "gallery.StartUpload",
        "gallery.Download",
        "gallery.Image",
        "gallery.Thumb",
        "gallery.List",
        "gallery.Objects",
        "gallery.Reindex",
        "gallery.ReindexRuns",
        "gallery.Cleanup"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-onuploaded",
      "package": "gallery",
      "handlers": [
        "gallery.OnUploaded"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-makethumb",
      "package": "gallery",
      "handlers": [
        "gallery.MakeThumb"
      ],
      "profile": "batch",
      "footprint": {
        "memory": "4Gi",
        "concurrency": 4,
        "max_instances": 5
      }
    },
    {
      "name": "gallery-notifyowner",
      "package": "gallery",
      "handlers": [
        "gallery.NotifyOwner"
      ],
      "profile": "default"
    },
    {
      "name": "gallery-warmfeed",
      "package": "gallery",
      "handlers": [
        "gallery.WarmFeed"
      ],
      "profile": "default"
    }
  ],
  "resources": [
    {
      "kind": "bucket",
      "name": "photos",
      "var": "gallery.photos",
      "package": "gallery",
      "pos": "app.go:21:2"
    },
    {
      "kind": "entity",
      "name": "photos",
      "var": "gallery.photoStore",
      "package": "gallery",
      "type": "Photo",
      "indexes": [
        "Owner",
        "Ready"
      ],
      "composites": [
        [
          "owner",
          "ready"
        ]
      ],
      "pos": "app.go:22:2"
    },
    {
      "kind": "queue",
      "name": "thumbnails",
      "var": "gallery.thumbs",
      "package": "gallery",
      "type": "ThumbJob",
      "max_attempts": 5,
      "min_backoff_seconds": 10,
      "max_backoff_seconds": 300,
      "pos": "app.go:23:2"
    },
    {
      "kind": "topic",
      "name": "photo-ready",
      "var": "gallery.ready",
      "package": "gallery",
      "type": "PhotoReady",
      "max_attempts": 5,
      "min_backoff_seconds": 10,
      "max_backoff_seconds": 300,
      "pos": "app.go:24:2"
    },
    {
      "kind": "cache",
      "name": "feed",
      "var": "gallery.feed",
      "package": "gallery",
      "max_attempts": 5,
      "min_backoff_seconds": 10,
      "max_backoff_seconds": 300,
      "pos": "app.go:30:2"
    },
    {
      "kind": "secret",
      "name": "notifier-key",
      "var": "gallery.notifier",
      "package": "gallery",
      "max_attempts": 5,
      "min_backoff_seconds": 10,
      "max_backoff_seconds": 300,
      "pos": "app.go:31:2"
    },
    {
      "kind": "counter",
      "name": "uploads",
      "var": "gallery.ups",
      "package": "gallery",
      "max_attempts": 5,
      "min_backoff_seconds": 10,
      "max_backoff_seconds": 300,
      "pos": "app.go:32:2"
    },
    {
      "kind": "histogram",
      "name": "thumb_ms",
      "var": "gallery.thumbMs",
      "package": "gallery",
      "max_attempts": 5,
      "min_backoff_seconds": 10,
      "max_backoff_seconds": 300,
      "pos": "app.go:33:2"
    },
    {
      "kind": "lock",
      "name": "reindex",
      "var": "gallery.relock",
      "package": "gallery",
      "pos": "app.go:39:2"
    },
    {
      "kind": "entity",
      "name": "reindex-runs",
      "var": "gallery.reruns",
      "package": "gallery",
      "type": "ReindexRun",
      "pos": "app.go:40:2"
    },
    {
      "kind": "channel",
      "name": "oncall",
      "var": "gallery.oncall",
      "package": "gallery",
      "channel_kind": "email",
      "target": "ops@example.com",
      "pos": "app.go:96:2"
    },
    {
      "kind": "alert",
      "name": "Stuck",
      "var": "gallery.Stuck",
      "package": "gallery",
      "condition": "QueueBacklogged",
      "alert": {
        "op": "atleast",
        "subject_kind": "queue",
        "subject_name": "thumbnails",
        "subject_var": "gallery.thumbs",
        "reading": "queue_depth",
        "threshold": 1,
        "for_seconds": 600,
        "on": "dead"
      },
      "channels": [
        "gallery.oncall"
      ],
      "pos": "app.go:99:2"
    },
    {
      "kind": "alert",
      "name": "Silent",
      "var": "gallery.Silent",
      "package": "gallery",
      "condition": "CronMissed",
      "alert": {
        "op": "absent",
        "subject_kind": "cron",
        "subject_var": "gallery.Cleanup",
        "reading": "cron_missed",
        "for_seconds": 300
      },
      "channels": [
        "gallery.oncall"
      ],
      "pos": "app.go:104:2"
    }
  ],
  "handlers": [
    {
      "kind": "api",
      "var": "gallery.Upload",
      "package": "gallery",
      "service": "gallery",
      "route": "POST /api/photos",
      "req_type": "UploadReq",
      "req_ref": "gallery.UploadReq",
      "res_ref": "gallery.Photo",
      "bindings": [
        {
          "field": "Caption",
          "kind": "form",
          "name": "caption",
          "type": "string"
        },
        {
          "field": "Img",
