{
  "module": "journal",
  "services": [
    {
      "name": "journal",
      "package": "journal",
      "handlers": [
        "journal.Home",
        "journal.Read",
        "journal.Write",
        "journal.Save",
        "journal.Publish",
        "journal.Rename",
        "journal.Perma"
      ],
      "profile": "default"
    }
  ],
  "resources": [
    {
      "kind": "entity",
      "name": "posts",
      "var": "journal.posts",
      "package": "journal",
      "type": "Post",
      "indexes": [
        "Published",
        "Created"
      ],
      "composites": [
        [
          "published",
          "-created"
        ]
      ],
      "composite_sources": [
        "app.go:101 home"
      ],
      "pos": "app.go:15:2"
    },
    {
      "kind": "entity",
      "name": "moved_urls",
      "var": "journal.moved",
      "package": "journal",
      "type": "MovedURL",
      "pos": "app.go:24:2"
    },
    {
      "kind": "site",
      "name": "./web",
      "var": "journal.site",
      "package": "journal",
      "dir": "web",
      "not_found": "404.html",
      "redirects": [
        {
          "from": "/about-us",
          "to": "/about"
        }
      ],
      "pos": "app.go:28:2"
    },
    {
      "kind": "auth",
      "name": "auth",
      "var": "journal.auth",
      "package": "journal",
      "providers": [
        "google"
      ],
      "pos": "app.go:41:2"
    }
  ],
  "handlers": [
    {
      "kind": "page",
      "var": "journal.Home",
      "package": "journal",
      "service": "journal",
      "route": "GET /",
      "req_ref": "struct{}",
      "res_ref": "tako.HTML",
      "pos": "app.go:61:2"
    },
    {
      "kind": "page",
      "var": "journal.Read",
      "package": "journal",
      "service": "journal",
      "route": "GET /p/{id}",
      "req_type": "ReadReq",
      "req_ref": "journal.ReadReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "pos": "app.go:62:2"
    },
    {
      "kind": "page",
      "var": "journal.Write",
      "package": "journal",
      "service": "journal",
      "route": "GET /write",
      "req_ref": "struct{}",
      "res_ref": "tako.HTML",
      "pos": "app.go:63:2"
    },
    {
      "kind": "page",
      "var": "journal.Save",
      "package": "journal",
      "service": "journal",
      "route": "POST /p",
      "requires_auth": true,
      "req_type": "SaveReq",
      "req_ref": "journal.SaveReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "Title",
          "kind": "form",
          "name": "title",
          "type": "string"
        },
        {
          "field": "Body",
          "kind": "form",
          "name": "body",
          "type": "string"
        }
      ],
      "pos": "app.go:64:2"
    },
    {
      "kind": "page",
      "var": "journal.Publish",
      "package": "journal",
      "service": "journal",
      "route": "POST /p/{id}/publish",
      "requires_auth": true,
      "req_type": "PublishReq",
      "req_ref": "journal.PublishReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "pos": "app.go:65:2"
    },
    {
      "kind": "page",
      "var": "journal.Rename",
      "package": "journal",
      "service": "journal",
      "route": "POST /p/{id}/rename",
      "requires_auth": true,
      "req_type": "RenameReq",
      "req_ref": "journal.RenameReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        },
        {
          "field": "Slug",
          "kind": "form",
          "name": "slug",
          "type": "string"
        }
      ],
      "pos": "app.go:66:2"
    },
    {
      "kind": "page",
      "var": "journal.Perma",
      "package": "journal",
      "service": "journal",
      "route": "GET /{year}/{slug}",
      "req_type": "PermaReq",
      "req_ref": "journal.PermaReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "Year",
          "kind": "path",
          "name": "year",
          "type": "string"
        },
        {
          "field": "Slug",
          "kind": "path",
          "name": "slug",
          "type": "string"
        }
      ],
      "pos": "app.go:73:2"
    }
  ],
  "edges": [
    {
      "from": "journal.Home",
      "to": "posts",
