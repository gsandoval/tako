{
  "module": "journal",
  "services": [
    {
      "name": "journal",
      "package": "journal",
      "handlers": [
        "journal.Home",
        "journal.Read",
        "journal.Write",
        "journal.Save",
        "journal.Publish"
      ],
      "profile": "default"
    }
  ],
  "resources": [
    {
      "kind": "entity",
      "name": "posts",
      "var": "journal.posts",
      "package": "journal",
      "type": "Post",
      "indexes": [
        "Published",
        "Created"
      ],
      "composites": [
        [
          "published",
          "-created"
        ]
      ],
      "pos": "app.go:15:2"
    },
    {
      "kind": "site",
      "name": "./web",
      "var": "journal.site",
      "package": "journal",
      "dir": "web",
      "redirects": [
        {
          "from": "/about-us",
          "to": "/about"
        }
      ],
      "pos": "app.go:19:2"
    },
    {
      "kind": "auth",
      "name": "auth",
      "var": "journal.auth",
      "package": "journal",
      "providers": [
        "google"
      ],
      "pos": "app.go:24:2"
    }
  ],
  "handlers": [
    {
      "kind": "page",
      "var": "journal.Home",
      "package": "journal",
      "service": "journal",
      "route": "GET /",
      "req_ref": "struct{}",
      "res_ref": "tako.HTML",
      "pos": "app.go:37:2"
    },
    {
      "kind": "page",
      "var": "journal.Read",
      "package": "journal",
      "service": "journal",
      "route": "GET /p/{id}",
      "req_type": "ReadReq",
      "req_ref": "journal.ReadReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "pos": "app.go:38:2"
    },
    {
      "kind": "page",
      "var": "journal.Write",
      "package": "journal",
      "service": "journal",
      "route": "GET /write",
      "req_ref": "struct{}",
      "res_ref": "tako.HTML",
      "pos": "app.go:39:2"
    },
    {
      "kind": "page",
      "var": "journal.Save",
      "package": "journal",
      "service": "journal",
      "route": "POST /p",
      "requires_auth": true,
      "req_type": "SaveReq",
      "req_ref": "journal.SaveReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "Title",
          "kind": "form",
          "name": "title",
          "type": "string"
        },
        {
          "field": "Body",
          "kind": "form",
          "name": "body",
          "type": "string"
        }
      ],
      "pos": "app.go:40:2"
    },
    {
      "kind": "page",
      "var": "journal.Publish",
      "package": "journal",
      "service": "journal",
      "route": "POST /p/{id}/publish",
      "requires_auth": true,
      "req_type": "PublishReq",
      "req_ref": "journal.PublishReq",
      "res_ref": "tako.HTML",
      "bindings": [
        {
          "field": "ID",
          "kind": "path",
          "name": "id",
          "type": "string"
        }
      ],
      "pos": "app.go:41:2"
    }
  ],
  "edges": [
    {
      "from": "journal.Home",
      "to": "posts",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "read"
    },
    {
      "from": "journal.Read",
      "to": "posts",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "read"
    },
    {
      "from": "journal.Save",
      "to": "posts",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "write"
    },
    {
      "from": "journal.Publish",
      "to": "posts",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "read"
    },
    {
      "from": "journal.Publish",
      "to": "posts",
      "to_kind": "entity",
      "kind": "resource",
      "verb": "write"
    }
  ]
}
